  <property name="styleSheet">
   <string>
    /* 1. TITRES : Labels et GroupBox */
    QLabel, QGroupBox {
        font-weight: bold;
        color: #2c3e50;
    }

    /* 2. INFOBULLES : Pas de gras, bordure fine */
    QToolTip {
        font-weight: normal;
        background-color: #ffe089;
        border: 1px solid #bdc3c7;
        color: #2c3e50;
        padding: 2px;
    }

    /* 3. CHAMPS DE SAISIE : Bordures arrondies et texte normal */
    QComboBox, QSpinBox, QLineEdit, QTextEdit, QDateEdit {
        border: 1px solid #bdc3c7;
        border-radius: 4px;
        padding: 3px 5px;
        background-color: white;
        selection-background-color: #3498db;
        selection-color: white;
        font-weight: normal;
    }

    /* Focus sur les champs */
    QComboBox:focus, QSpinBox:focus, QLineEdit:focus, QTextEdit:focus, QDateEdit:focus {
        border: 1px solid #3498db;
    }

    /* 4. GROUPBOX : Cadre uniformisé */
    QGroupBox { 
        border: 1px solid #bdc3c7; 
        border-radius: 6px; 
        margin-top: 15px; 
    } 
    QGroupBox::title { 
        subcontrol-origin: margin; 
        left: 10px; 
        padding: 0 5px; 
    }

    /* 5. BOUTONS */
    QPushButton {
        border: 1px solid #bdc3c7;
        border-radius: 4px;
        background-color: #f8f9fa;
        padding: 5px;
        font-weight: normal;
    }
    QPushButton:hover {
        background-color: #e9ecef;
    }
   </string>
  </property>

