        QComboBox, QSpinBox, QLineEdit, QTextEdit, QDateEdit { border: 1px solid #bdc3c7; border-radius: 4px; padding: 3px 5px; background-color: white; font-weight: normal; }
        QGroupBox { border: 1px solid #bdc3c7; border-radius: 6px; margin-top: 15px; } 
        QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }
        QPushButton { border: 1px solid #bdc3c7; border-radius: 4px; background-color: #f8f9fa; padding: 5px; }
        QFrame#rowBlock { border: none; background-color: transparent; padding-bottom: 15px; }
        QSplitter::handle { background-color: #dcdde1; border-left: 1px solid #bdc3c7; border-right: 1px solid #bdc3c7; }
        QSplitter::handle:horizontal { width: 10px; }
        QSplitter::handle:hover { background-color: #3498db; }
